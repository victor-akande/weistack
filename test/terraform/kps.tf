# KPS key pairs (generated, imported, and KMS-protected), the deprecated Nova
# key pair resource, and the KPS keypairs data source.

variable "kps_public_key" {
  type        = string
  description = "Ephemeral OpenSSH public key generated by run.sh."
}

resource "huaweicloud_kps_keypair" "generated" {
  name        = "tf-kps-generated"
  key_file    = "${path.module}/tf-kps-generated.pem"
  description = "Generated by Terraform"
}

resource "huaweicloud_kps_keypair" "imported" {
  name        = "tf-kps-imported"
  public_key  = var.kps_public_key
  description = "Imported by Terraform"
}

resource "huaweicloud_kps_keypair" "kms" {
  name            = "tf-kps-kms"
  encryption_type = "kms"
  kms_key_id      = huaweicloud_kms_key.app.id
  key_file        = "${path.module}/tf-kps-kms.pem"
}

resource "huaweicloud_compute_keypair" "nova" {
  name       = "tf-nova-keypair"
  public_key = var.kps_public_key
}

data "huaweicloud_kps_keypairs" "all" {
  depends_on = [
    huaweicloud_kps_keypair.generated,
    huaweicloud_kps_keypair.imported,
    huaweicloud_kps_keypair.kms,
    huaweicloud_compute_keypair.nova,
  ]
}

output "kps" {
  value = {
    generated_name    = huaweicloud_kps_keypair.generated.name
    generated_managed = huaweicloud_kps_keypair.generated.is_managed
    imported_name     = huaweicloud_kps_keypair.imported.name
    kms_managed       = huaweicloud_kps_keypair.kms.is_managed
    nova_name         = huaweicloud_compute_keypair.nova.name
    keypairs_count    = length(data.huaweicloud_kps_keypairs.all.keypairs)
    web_key_pair      = huaweicloud_compute_instance.web.key_pair
  }
}
