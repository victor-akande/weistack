# Dedicated ELB v3: load balancer with EIP, HTTP listener + pool + health
# monitor + ECS backend member, certificate, security policy, IP group,
# HTTPS listener, L7 policy + rule, and data sources.

variable "elb_certificate" {
  type        = string
  description = "Ephemeral PEM certificate generated by run.sh."
}

variable "elb_private_key" {
  type        = string
  sensitive   = true
  description = "Ephemeral PEM private key generated by run.sh."
}

data "huaweicloud_elb_flavors" "l4" {
  type = "L4"
}

data "huaweicloud_elb_flavors" "l7" {
  type = "L7"
}

resource "huaweicloud_vpc_eip" "elb" {
  name = "tf-elb-eip"

  publicip {
    type = "5_bgp"
  }

  bandwidth {
    name        = "tf-elb-bw"
    size        = 5
    share_type  = "PER"
    charge_mode = "bandwidth"
  }
}

resource "huaweicloud_elb_loadbalancer" "main" {
  name              = "tf-elb"
  description       = "tf dedicated elb"
  vpc_id            = huaweicloud_vpc.main.id
  ipv4_subnet_id    = huaweicloud_vpc_subnet.main.ipv4_subnet_id
  ipv4_eip_id       = huaweicloud_vpc_eip.elb.id
  l4_flavor_id      = data.huaweicloud_elb_flavors.l4.flavors[0].id
  l7_flavor_id      = data.huaweicloud_elb_flavors.l7.flavors[0].id
  availability_zone = [data.huaweicloud_availability_zones.zones.names[0]]

  tags = {
    env = "test"
  }
}

resource "huaweicloud_elb_listener" "http" {
  name            = "tf-elb-http"
  protocol        = "HTTP"
  protocol_port   = 80
  loadbalancer_id = huaweicloud_elb_loadbalancer.main.id

  tags = {
    proto = "http"
  }
}

resource "huaweicloud_elb_pool" "http" {
  name           = "tf-elb-http-pool"
  protocol       = "HTTP"
  lb_method      = "ROUND_ROBIN"
  listener_id    = huaweicloud_elb_listener.http.id
  cascade_delete = true
}

resource "huaweicloud_elb_monitor" "http" {
  pool_id     = huaweicloud_elb_pool.http.id
  protocol    = "HTTP"
  interval    = 5
  timeout     = 3
  max_retries = 3
  url_path    = "/health"
}

resource "huaweicloud_elb_member" "web" {
  pool_id       = huaweicloud_elb_pool.http.id
  address       = huaweicloud_compute_instance.web.access_ip_v4
  protocol_port = 80
  subnet_id     = huaweicloud_vpc_subnet.main.ipv4_subnet_id
  weight        = 10

  depends_on = [huaweicloud_elb_monitor.http]
}

resource "huaweicloud_elb_certificate" "main" {
  name        = "tf-elb-cert"
  type        = "server"
  domain      = "tf-elb.example.com"
  certificate = var.elb_certificate
  private_key = var.elb_private_key
}

resource "huaweicloud_elb_security_policy" "main" {
  name        = "tf-elb-secpol"
  description = "tf custom tls policy"
  protocols   = ["TLSv1.2", "TLSv1.3"]
  ciphers     = ["ECDHE-RSA-AES128-GCM-SHA256", "TLS_AES_128_GCM_SHA256"]
}

resource "huaweicloud_elb_ipgroup" "main" {
  name        = "tf-elb-ipg"
  description = "tf allowlist"

  ip_list {
    ip          = "10.0.0.0/8"
    description = "internal"
  }
}

resource "huaweicloud_elb_listener" "https" {
  name               = "tf-elb-https"
  protocol           = "HTTPS"
  protocol_port      = 443
  loadbalancer_id    = huaweicloud_elb_loadbalancer.main.id
  server_certificate = huaweicloud_elb_certificate.main.id
  security_policy_id = huaweicloud_elb_security_policy.main.id
  access_policy      = "white"
  ip_group           = huaweicloud_elb_ipgroup.main.id
}

resource "huaweicloud_elb_l7policy" "main" {
  name             = "tf-elb-l7policy"
  listener_id      = huaweicloud_elb_listener.https.id
  redirect_pool_id = huaweicloud_elb_pool.http.id
}

resource "huaweicloud_elb_l7rule" "main" {
  l7policy_id  = huaweicloud_elb_l7policy.main.id
  type         = "PATH"
  compare_type = "STARTS_WITH"
  value        = "/api"
}

data "huaweicloud_elb_loadbalancers" "main" {
  loadbalancer_id = huaweicloud_elb_loadbalancer.main.id
}

data "huaweicloud_elb_listeners" "main" {
  listener_id = huaweicloud_elb_listener.http.id
}

data "huaweicloud_elb_pools" "main" {
  pool_id = huaweicloud_elb_pool.http.id
}

output "elb" {
  value = {
    lb_name            = huaweicloud_elb_loadbalancer.main.name
    member_status      = huaweicloud_elb_member.web.operating_status
    flavors_l4_count   = length(data.huaweicloud_elb_flavors.l4.flavors)
    flavors_l7_count   = length(data.huaweicloud_elb_flavors.l7.flavors)
    loadbalancers_cnt  = length(data.huaweicloud_elb_loadbalancers.main.loadbalancers)
    listeners_cnt      = length(data.huaweicloud_elb_listeners.main.listeners)
    pools_cnt          = length(data.huaweicloud_elb_pools.main.pools)
    l7rule_value       = huaweicloud_elb_l7rule.main.value
    cert_domain        = huaweicloud_elb_certificate.main.domain
  }
}
